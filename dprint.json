{
  "markdown": {
    "lineWidth": 100,
    "textWrap": "maintain"
  },
  "json": {
    "indentWidth": 2
  },
  "includes": [
    "**/*.md",
    "**/*.json",
    "**/*.jsonc"
  ],
  "excludes": [
    ".git",
    "node_modules",
    "AGENTS.md",
    // Generated by sdd, which owns their form (project-platform:hooks-exclude-generated-files).
    ".spec-driven-docs/manifest.json",
    // Written whole by rk (project-platform:hooks-exclude-generated-files).
    ".release-kit/manifest.json",
    "_docs/.markdownlint-cli2.jsonc",
    // Shipped by sdd and kept byte-equal to its copy, so no formatter reshapes them.
    "_docs/specs/SPEC-budget-debt.md",
    "_docs/specs/SPEC-comparison-docs.md",
    "_docs/specs/SPEC-decision-records.md",
    "_docs/specs/SPEC-docs-format.md",
    "_docs/specs/SPEC-docs-foundations.md",
    "_docs/specs/SPEC-docs-specs.md",
    "_docs/specs/SPEC-guides.md",
    "_docs/specs/SPEC-instance.md",
    "_docs/specs/SPEC-known-issues.md",
    "_docs/specs/SPEC-spec-to-code.md",
    "_docs/specs/SPEC-tracking.md",
    "_docs/specs/SPEC-writing-policy.md",
    "_docs/specs/SPEC-writing-style.md",
    "_docs/specs/SPEC-tracking/tracking.schema.json",
    "_docs/specs/TEMPLATE-spec.md",
    "_docs/decisions/TEMPLATE-adr.md",
    "_docs/reference/TEMPLATE-agents-digest.md",
    "_docs/guides/TEMPLATE-guide.md",
    "_docs/reference/TEMPLATE-known-issue.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.0.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm"
  ]
}
