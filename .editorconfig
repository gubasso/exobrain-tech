# EditorConfig for markdown/docs projects.
# Markdown formatting is owned by dprint + markdownlint, and editorconfig-checker
# excludes *.md, so no markdown indent block is set here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,json5,jsonc,yaml,yml,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# A bucket may ship a shell script a reader copies and runs. shfmt reads this
# block when it is called with no formatting flags, so the style lives here
# once and both gates read the same source. `binary_next_line` and
# `switch_case_indent` are shfmt's own properties, and editorconfig-checker
# ignores what it does not know.
#
# shfmt's `-s` is deliberately absent: it rewrites code rather than laying it
# out, and it strips the quotes inside `[[ ]]` that a reader of a teaching
# artifact copies for good reasons elsewhere.
[*.{sh,bash,bats}]
indent_style = space
indent_size = 2
binary_next_line = true
switch_case_indent = true

[*.md]
trim_trailing_whitespace = false
max_line_length = off

# A Bugzilla ticket body kept as a standalone file, rather than as a fenced
# `## Report` section, is the same rule as `ki-bugzilla-report-width` reached
# through editorconfig: Bugzilla renders a comment as preformatted text in a
# fixed-width box and reflows nothing. The tracker sits in a compound suffix
# (`*.test.js` convention) so the file keeps the type editors and formatters
# see while the rule gets a handle a glob can address — a sibling `*.jira.txt`
# is deliberately not matched, because Jira reflows prose.
[*.bugzilla.txt]
max_line_length = 79
