# shellcheck shell=bash
# nix-direnv is recommended for evaluation caching only. It is NOT required for
# GC safety: direnv's own `use_flake` runs `nix print-dev-env --profile
# "$(direnv_layout_dir)/flake-profile"`, and a Nix profile generation is a
# permanent GC root (`createGeneration` -> `addPermRoot`), so the devShell's
# store paths survive `nix-collect-garbage` with or without nix-direnv. Do not
# add a `nix_direnv_version` probe to solve a problem that does not exist.
#
# Interactive shells enter the devShell on `cd`, after a one-time `direnv
# allow`. Non-interactive contexts — CI, agents, editor tasks, `bash -c` — do
# not fire the prompt hook and must wrap commands explicitly:
#     nix develop --command pre-commit run --all-files
#     direnv exec . <cmd>
use flake

# The plan-xp input tracks `develop` but is pinned by flake.lock, so the pin
# falls behind silently and by design. This says so, once a day, on the way into
# the shell.
#
# It never touches the lock. An environment that re-pins itself on `cd` is not
# reproducible: two checkouts entered an hour apart would run different linters,
# and the version `just test-plan` gates against would change with no commit to
# explain it. `just update-plan-xp` is the only thing that moves the pin.
#
# Two states are worth distinguishing, which is why this asks the compare API
# rather than reading a branch tip. An ordinary lag is routine. A pinned
# revision that no longer exists upstream is not: it still resolves from a warm
# local store and fails outright on a fresh clone, so it reads as working right
# up until someone else checks the repository out.
#
# Never fails the shell and never blocks it for long: offline, rate-limited, or
# unparsable all mean say nothing and ask again tomorrow.
#
# The verdict is cached under the direnv layout directory, whose location is the
# user's to configure, so the path is exported rather than assumed: it is how
# `just update-plan-xp` retires a stale advisory the moment it acts on one.
_plan_xp_freshness() {
  local cache pinned body code status ahead
  cache="$(direnv_layout_dir)/plan-xp-freshness"
  export PLAN_XP_FRESHNESS_CACHE="$cache"

  if [ -f "$cache" ] &&
    [ "$(($(date +%s) - $(stat -c %Y "$cache" 2> /dev/null || echo 0)))" -lt 86400 ]; then
    [ -s "$cache" ] && cat "$cache"
    return 0
  fi

  pinned="$(jq -r '.nodes["plan-xp"].locked.rev // empty' flake.lock 2> /dev/null)" || return 0
  [ -n "$pinned" ] || return 0

  mkdir -p "$(dirname "$cache")"
  body="$(curl -sS --connect-timeout 2 --max-time 5 -w '\n%{http_code}' \
    "https://api.github.com/repos/gubasso/plan-xp/compare/$pinned...develop" 2> /dev/null)" || return 0
  code="${body##*$'\n'}"
  body="${body%$'\n'*}"

  : > "$cache"
  case "$code" in
    200)
      status="$(printf '%s' "$body" | jq -r '.status // empty' 2> /dev/null)"
      ahead="$(printf '%s' "$body" | jq -r '.ahead_by // 0' 2> /dev/null)"
      case "$status" in
        identical) ;;
        ahead)
          printf 'plan-xp: the pin is %s commit(s) behind develop.\n  Update it with:  just update-plan-xp\n' \
            "$ahead" > "$cache"
          ;;
        '') ;;
        *)
          printf 'plan-xp: the pin has diverged from develop (%s).\n  Update it with:  just update-plan-xp\n' \
            "$status" > "$cache"
          ;;
      esac
      ;;
    404)
      printf 'plan-xp: the pinned revision %s NO LONGER EXISTS upstream.\n  It resolves here from the local store and will fail on a fresh clone.\n  Update it with:  just update-plan-xp\n' \
        "${pinned:0:8}" > "$cache"
      ;;
    *) ;;
  esac

  [ -s "$cache" ] && cat "$cache"
  return 0
}
_plan_xp_freshness
