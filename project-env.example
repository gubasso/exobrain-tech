# shellcheck shell=bash
# Developer-specific values for the release-kit bot setup steps. Copy this
# file to ~/.config/project-env/exobrain-tech.env, outside the checkout, and
# fill it in there. The .envrc of every worktree sources that one file. It
# names a private key on this machine, so it never enters the repository.
#
# The file holds values that the operator chooses. A credential belongs
# behind a credential gateway, not in an environment variable.
#
# Both are empty on purpose — rk setup guards on its own variables, so an
# unfilled value fails loudly instead of reaching the GitHub API.

# The App ID, from the "About" section of
# https://github.com/settings/apps/gubasso-ci-bot
export RK_BOT_APP_ID=''

# Absolute path to the private key downloaded from the same page, e.g.
# /home/you/Downloads/gubasso-ci-bot.2026-08-26.private-key.pem
export RK_BOT_PRIVATE_KEY_FILE=''
