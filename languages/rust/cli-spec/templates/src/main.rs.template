//! Binary entry point.
//!
//! `main` is the process boundary and nothing else: it renders the error chain
//! once and classifies it once. All the work — parsing args, initializing
//! logging, building `AppContext`, dispatching — lives in `run`, which returns
//! `Result` so `?` is available. See ADR-0002 for why this split is forced
//! rather than stylistic. NO business logic here OR in `run` — if you find
//! yourself writing logic, lift it into `commands/`, `services/`, or `adapters/`.

use clap::Parser;
use std::process::ExitCode;

mod cli;
mod commands;
mod config;
mod context;
mod domain;
mod error;
mod logging;
mod ui;
// mod adapters;   // uncomment when you add adapters
// mod services;   // uncomment when you add shared services

use crate::cli::{Cli, Commands};
use crate::context::AppContext;
use crate::error::AppError;

fn main() -> ExitCode {
    // `Cli::parse()` belongs here, not in `run`: `main` owns the connection to `argv`, and `run`
    // receives what it needs. clap handles its own parse failures and exits, so this adds no
    // second error path. See ADR-0002.
    match run(Cli::parse()) {
        Ok(()) => ExitCode::SUCCESS,
        Err(e) => {
            print_error(&e);
            ExitCode::from(e.exit_code())
        }
    }
}

fn run(cli: Cli) -> Result<(), AppError> {
    logging::init(cli.global.verbose)?;
    let ctx = AppContext::new(&cli)?;

    match cli.command {
        Commands::Example(args) => commands::example::run(&ctx, args),
        // add one arm per subcommand
    }
}

fn print_error(e: &AppError) {
    eprintln!("app: {e}");
    let mut source = std::error::Error::source(e);
    while let Some(cause) = source {
        eprintln!("  caused by: {cause}");
        source = cause.source();
    }
}
