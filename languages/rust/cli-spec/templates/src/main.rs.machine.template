//! Machine-facing binary entry point.
//!
//! `main` is the process boundary and nothing else: it emits one structured error
//! envelope and classifies it once. All the work — parsing args, initializing
//! file-first logging with no stderr mirror by default, building `AppContext`,
//! dispatching — lives in `run`, which returns `Result` so `?` is available.
//! This split is forced rather than stylistic. NO business logic
//! here OR in `run` — if you find yourself writing logic, lift it into
//! `commands/`, `services/`, or `adapters/`.

use clap::Parser;
use std::process::ExitCode;

mod cli;
mod commands;
mod config;
mod context;
mod domain;
mod error;
mod logging;
// mod adapters;   // uncomment when you add adapters
// mod output;     // structured machine-output helpers, if needed
// mod protocol;   // protocol types, if needed
// mod services;   // uncomment when you add shared services

use crate::cli::{Cli, Commands};
use crate::context::AppContext;
use crate::error::AppError;

fn main() -> ExitCode {
    // `Cli::parse()` belongs here, not in `run`: `main` owns the connection to `argv`, and `run`
    // receives what it needs. clap handles its own parse failures and exits, so this adds no
    // second error path.
    match run(Cli::parse()) {
        Ok(()) => ExitCode::SUCCESS,
        Err(e) => {
            print_error(&e);
            ExitCode::from(e.exit_code())
        }
    }
}

fn run(cli: Cli) -> Result<(), AppError> {
    // A logging failure arrives as `AppError::Other` and classifies to EX_SOFTWARE (70), so it
    // needs no special case — that is the point of routing every failure through one type.
    logging::init(cli.global.verbose, false)?;
    let ctx = AppContext::new(&cli)?;

    match cli.command {
        Commands::Example(args) => commands::example::run(&ctx, args),
        // Commands::Doctor(args) => commands::doctor::run(&ctx, args),
        // Commands::Init(args) => commands::init::run(&ctx, args),
        // add one arm per subcommand
    }
}

// Error envelopes share one stable schema — {"ok":false,"error":{kind,message,exit_code}} — and go
// to stderr with a non-zero exit code, honoring the universal Unix stdout/stderr contract (see the
// channel matrix in cli-design/01-logging-and-output.md): stdout carries only the successful result,
// errors go to stderr. This holds for machine-facing tools too — agents expect it.
//
// If this binary is supervised by systemd rather than invoked from a shell, this envelope is what
// lands in the journal, and it is the more valuable half of the failure report — the manager itself
// only distinguishes zero from non-zero. See 03-error-handling.md, "Binaries a service manager
// supervises".
fn print_error(e: &AppError) {
    eprintln!(
        "{{\"ok\":false,\"error\":{{\"kind\":\"{}\",\"message\":{},\"exit_code\":{}}}}}",
        error_kind(e),
        json_string(&e.to_string()),
        e.exit_code()
    );
}

fn error_kind(e: &AppError) -> &'static str {
    match e {
        AppError::Usage(_) => "Usage",
        AppError::Config(_) => "Config",
        AppError::Io(_) => "Io",
        AppError::Other(_) => "Other",
    }
}

fn json_string(value: &str) -> String {
    serde_json::to_string(value).unwrap_or_else(|_| "\"<unprintable>\"".to_string())
}
