#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHECK="$ROOT/check-plan"
FIXTURE="$ROOT/example"
TMP="$(mktemp -d "$ROOT/.test-check-plan.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

copy_fixture() {
  local name="$1"
  cp -R "$FIXTURE" "$TMP/$name"
  printf '%s\n' "$TMP/$name"
}

replace_section() { # replace_section <file> <heading> <body...>
  local file="$1" heading="$2"
  shift 2
  awk -v heading="$heading" -v body="$(printf '%s\n' "$@")" '
    $0 == heading { print; print ""; printf "%s", body; skip=1; next }
    skip && /^## / { skip=0; print "" }
    skip { next }
    { print }
  ' "$file" > "$file.tmp"
  mv "$file.tmp" "$file"
}

expect_failure() { # expect_failure <message> <command...>
  local message="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf '%s\n' "$message" >&2
    exit 1
  fi
}

make_todo_illegal() {
  local file="$1"
  awk 'BEGIN { RS=""; ORS="\n\n" }
    NR == 1 { header=$0; next }
    NR == 2 { first=$0; next }
    NR == 3 { print header; print $0; print first; next }
    { print }
  ' "$file" > "$file.tmp"
  mv "$file.tmp" "$file"
}

"$CHECK" "$FIXTURE"
"$CHECK" --rank-slots "$FIXTURE" >/dev/null

# An illegal order becomes legal without losing the original line blocks.
zone="$(copy_fixture illegal)"
make_todo_illegal "$zone/lanes/todo.yml"
grep -q '^# yaml-language-server:' "$zone/lanes/todo.yml"
"$CHECK" --rank-fix "$zone"
"$CHECK" "$zone"
grep -q '^# yaml-language-server:' "$zone/lanes/todo.yml"
grep -q '^$' "$zone/lanes/todo.yml"
# Every entry line survives the move unchanged; only the order differs, so a
# writer that re-serialized an entry or dropped a field fails here.
diff <(grep -v '^[[:space:]]*$' "$FIXTURE/lanes/todo.yml" | sort) \
  <(grep -v '^[[:space:]]*$' "$zone/lanes/todo.yml" | sort)

# Legal input is byte-identical.
zone="$(copy_fixture identity)"
cp "$zone/lanes/todo.yml" "$zone/todo.before"
"$CHECK" --rank-fix "$zone"
diff -u "$zone/todo.before" "$zone/lanes/todo.yml"

# A different legal permutation is also a fixed point; the writer is non-canonical.
zone="$(copy_fixture noncanonical)"
sed -i 's/needs: \["006"\]/needs: ["002"]/' "$zone/lanes/todo.yml"
make_todo_illegal "$zone/lanes/todo.yml"
cp "$zone/lanes/todo.yml" "$zone/todo.before"
"$CHECK" --rank-fix "$zone"
diff -u "$zone/todo.before" "$zone/lanes/todo.yml"

# A file with no final newline keeps none, or legal input is not byte-identical.
zone="$(copy_fixture nonewline)"
printf '%s' "$(cat "$zone/lanes/todo.yml")" > "$zone/todo.stripped"
mv "$zone/todo.stripped" "$zone/lanes/todo.yml"
cp "$zone/lanes/todo.yml" "$zone/todo.before"
"$CHECK" --rank-fix "$zone"
diff -u "$zone/todo.before" "$zone/lanes/todo.yml"

# Reported slots compose into one legal order, so no id may occupy two positions.
zone="$(copy_fixture slots)"
make_todo_illegal "$zone/lanes/todo.yml"
"$CHECK" --rank-slots "$zone" > "$zone/slots.txt"
awk '
  /\.yml$/ { split("", seen); next }
  { for (i = 2; i <= NF; i++) if (seen[$i]++) { print "slot id repeated: " $i; exit 1 } }
' "$zone/slots.txt"

# Repair is idempotent.
zone="$(copy_fixture idempotent)"
make_todo_illegal "$zone/lanes/todo.yml"
"$CHECK" --rank-fix "$zone"
cp "$zone/lanes/todo.yml" "$zone/todo.once"
"$CHECK" --rank-fix "$zone"
diff -u "$zone/todo.once" "$zone/lanes/todo.yml"

# A cycle exits non-zero and changes nothing.
zone="$(copy_fixture cycle)"
sed -i 's/needs: \["009"\]/needs: ["013"]/' "$zone/lanes/backlog.yml"
cp "$zone/lanes/backlog.yml" "$zone/backlog.before"
if "$CHECK" --rank-fix "$zone" >/dev/null 2>&1; then
  printf '%s\n' 'cycle unexpectedly passed' >&2
  exit 1
fi
diff -u "$zone/backlog.before" "$zone/lanes/backlog.yml"

# A story or spike without an Example fence is rejected.
zone="$(copy_fixture example)"
sed -i "/^\`\`\`console$/d; /^\`\`\`$/d" "$zone/stories/009-release-readiness.md"
expect_failure 'missing Example fence unexpectedly passed' "$CHECK" "$zone"

# A quoted type is schema-valid, so it must not slip past the Example gate.
zone="$(copy_fixture quotedtype)"
sed -i 's/^    type: story$/    type: "story"/' "$zone/lanes/todo.yml"
sed -i "/^\`\`\`console$/d; /^\`\`\`$/d" "$zone/stories/009-release-readiness.md"
expect_failure 'quoted type bypassed the Example gate' "$CHECK" "$zone"

# Inline code inside an Amends assertion is prose, not a second spec path.
zone="$(copy_fixture amends)"
# shellcheck disable=SC2016  # the backticks are Markdown inline code, not a subshell
replace_section "$zone/stories/002-secure-session-storage.md" '## Amends' \
  '- `check-plan` — the `--rank-fix` flag'
"$CHECK" "$zone"

# An absolute Amends path resolves on one machine only, so it is rejected even
# when the file it names is present here.
zone="$(copy_fixture amendsabs)"
replace_section "$zone/stories/002-secure-session-storage.md" '## Amends' \
  "- \`$CHECK\` — the claim"
expect_failure 'absolute Amends path unexpectedly passed' "$CHECK" "$zone"

# One id owns one story file, so a second file sharing its id is rejected.
zone="$(copy_fixture duplicate)"
cp "$zone/stories/002-secure-session-storage.md" "$zone/stories/002-typo.md"
expect_failure 'duplicate story file for one id unexpectedly passed' "$CHECK" "$zone"

# A question that blocks nothing belongs in drafts, so it must not be invisible.
zone="$(copy_fixture question)"
printf '\n## Q-005 — Unanchored?\n\nRaised: 2026-08-02 with no target.\n' >> "$zone/open-questions.md"
expect_failure 'question without a Blocks line unexpectedly passed' "$CHECK" "$zone"

printf '%s\n' 'check-plan tests passed'
